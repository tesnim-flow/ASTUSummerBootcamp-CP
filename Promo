n, q = list(map(int, input().split()))
p = list(map(int, input().split()))
p_sort = sorted(p)
pref = [0] * (n + 1)

for i in range(n):
    pref[i + 1] = pref[i] + p_sort[i]

for _ in range(q):
    x, y = map(int, input().split())
    ans = pref[n - x + y] - pref[n - x] 
    # 5-3+2=4       and     5-3=2
    # if pref=[0, 1, 3, 6, 11, 16]
    
    # free=11-3=8

    print(ans)
