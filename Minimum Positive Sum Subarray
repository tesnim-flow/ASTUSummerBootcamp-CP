class Solution:
    def minimumSumSubarray(self, nums: List[int], l: int, r: int) -> int:
        mini_sum = []
        for i in range(l, r+1):
            window_sum= sum(nums[:i])
            if window_sum > 0:
                mini_sum.append(window_sum)
            for j in range(i, len(nums)):
                window_sum = window_sum + nums[j] - nums[j-i]
                if window_sum> 0:
                    mini_sum.append(window_sum)
        if not mini_sum:
            return -1
        return min(mini_sum)
